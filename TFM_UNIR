        function calcularMatrizYRiesgos() {
            riesgosCruces = [];
            
            // Reconstruir Matriz sólo con Activos y Amenazas 'active'
            activos.forEach((act, i) => {
                if(!act.active) return;
                amenazas.forEach((am, j) => {
                    if(!am.active) return;

                    let impactoBase = act.val * (am.deg / 100);
                    let probBase = am.prob;
                    let riBase = (probBase / 100) * impactoBase;
                    
                    let idRiesgo = `R-${act.id}-${am.id}`;
                    
                    let sumPrev = 0;
                    let sumDetCor = 0;
                    let appliedCtrls = [];
                    let mitigatesProb = false;
                    let mitigatesImp = false;

                    for(let cid in controlesAplicadosGlob) {
                        let c = controlesISO.find(ctrl => ctrl.id === cid);
                        // Condición manual estricta (no hay automáticos)
                        if(c && (c.manualThreats.includes(am.coda) || c.manualRisks.includes(idRiesgo))) {
                            let efec = controlesAplicadosGlob[cid].efec;
                            appliedCtrls.push(`[${cid}]`);
                            
                            if(c.tipoCtrl === 'Preventivo') {
                                sumPrev += efec;
                                mitigatesProb = true;
                            } else { 
                                sumDetCor += efec;
                                mitigatesImp = true;
                            }
                        }
                    }

                    sumPrev = Math.min(1.0, sumPrev);
                    sumDetCor = Math.min(1.0, sumDetCor);

                    let probDesp = probBase * (1 - sumPrev);
                    let impDesp = impactoBase * (1 - sumDetCor);

                    impDesp = Math.max(1, Math.min(5, impDesp));
                    probDesp = Math.max(20, Math.min(100, probDesp));

                    let rr = (probDesp / 100) * impDesp;
                    rr = Math.max(1, Math.min(5, rr));

                    riesgosCruces.push({
                        id: idRiesgo, act: act, am: am, 
                        probBase: probBase, impBase: impactoBase, riBase: riBase,
                        probDesp: probDesp, impDesp: impDesp, rr: rr,
                        appliedCtrls: appliedCtrls, mitigatesProb: mitigatesProb, mitigatesImp: mitigatesImp,
                        nivelAntes: obtenerNivelYRango(riBase), nivelDesp: obtenerNivelYRango(rr)
                    });
                });
            });

            renderRiesgosBase();
            renderControlesISO();
            renderTratamiento();
            renderHeatmaps();
        }

