        function renderHeatmaps() {
            let matrixPuro = Array(6).fill().map(() => Array(6).fill(0));
            let matrixRes = Array(6).fill().map(() => Array(6).fill(0));
            
            let countsRi = { Bajo: 0, Medio: 0, Alto: 0, Critico: 0 };
            let countsRr = { Bajo: 0, Medio: 0, Alto: 0, Critico: 0 };

            riesgosCruces.forEach(r => {
                if(r.nivelAntes.text === 'Bajo') countsRi.Bajo++; else if(r.nivelAntes.text === 'Medio') countsRi.Medio++; else if(r.nivelAntes.text === 'Alto') countsRi.Alto++; else countsRi.Critico++;
                if(r.nivelDesp.text === 'Bajo') countsRr.Bajo++; else if(r.nivelDesp.text === 'Medio') countsRr.Medio++; else if(r.nivelDesp.text === 'Alto') countsRr.Alto++; else countsRr.Critico++;

                let pProbIdx = r.probBase <= 20 ? 1 : r.probBase <= 40 ? 2 : r.probBase <= 60 ? 3 : r.probBase <= 80 ? 4 : 5;
                let impIdx = Math.max(1, Math.min(5, Math.round(r.impBase))); 
                matrixPuro[impIdx][pProbIdx]++;
                
                let rProbIdx = r.probDesp <= 20 ? 1 : r.probDesp <= 40 ? 2 : r.probDesp <= 60 ? 3 : r.probDesp <= 80 ? 4 : 5;
                let rImpIdx = Math.max(1, Math.min(5, Math.round(r.impDesp)));
                matrixRes[rImpIdx][rProbIdx]++;
            });

            // Update DOM Heatmaps & Tooltips
            for(let y=1; y<=5; y++) {
                for(let x=1; x<=5; x++) {
                    let cellPuro = document.getElementById(`rp-${y}${x}`);
                    let cellRes = document.getElementById(`rr-${y}${x}`);
                    let vPuro = matrixPuro[y][x]; let vRes = matrixRes[y][x];
                    
                    let probText = ["Muy Baja", "Baja", "Media", "Alta", "Muy Alta"][x-1];
                    let impText = ["Insignificante", "Menor", "Moderado", "Grave", "Crítico"][y-1];
                    
                    cellPuro.title = vPuro > 0 ? `Riesgos: ${vPuro}\nImpacto: ${impText} (${y})\nProbabilidad: ${probText}` : '';
                    cellRes.title = vRes > 0 ? `Riesgos: ${vRes}\nImpacto: ${impText} (${y})\nProbabilidad: ${probText}` : '';

                    let sPuro = vPuro > 0 ? Math.min(26 + (vPuro * 0.8), 65) : 26; 
                    let sRes = vRes > 0 ? Math.min(26 + (vRes * 0.8), 65) : 26;
                    
                    cellPuro.innerHTML = `<div class="hm-bubble" style="width:${sPuro}px; height:${sPuro}px; ${vPuro === 0 ? 'opacity: 0.1;' : ''}">${vPuro}</div>`;
                    cellRes.innerHTML = `<div class="hm-bubble" style="width:${sRes}px; height:${sRes}px; ${vRes === 0 ? 'opacity: 0.1;' : ''}">${vRes}</div>`;
                }
            }

            const dataLabels = ['Bajo', 'Medio', 'Alto', 'Crítico'];
            const bgColors = ['#dcfce7', '#fef08a', '#fed7aa', '#fecaca'];
            const bColors = ['#166534', '#854d0e', '#c2410c', '#991b1b'];

            if (!chartInherenteInstance) {
                chartInherenteInstance = new Chart(document.getElementById('chartInherente'), {
                    type: 'bar', data: { labels: dataLabels, datasets: [{ label: 'Riesgos Base', data: [countsRi.Bajo, countsRi.Medio, countsRi.Alto, countsRi.Critico], backgroundColor: bgColors, borderColor: bColors, borderWidth: 1 }] },
                    options: { scales: { y: { beginAtZero: true, suggestedMax: Math.max(...Object.values(countsRi)) * 1.1 } }, plugins: { legend: { display: false } }, animation: { duration: 800 } }
                });
            } else {
                chartInherenteInstance.data.datasets[0].data = [countsRi.Bajo, countsRi.Medio, countsRi.Alto, countsRi.Critico];
                chartInherenteInstance.options.scales.y.suggestedMax = Math.max(...Object.values(countsRi)) * 1.1;
                chartInherenteInstance.update();
            }

            if (!chartResidualInstance) {
                chartResidualInstance = new Chart(document.getElementById('chartResidual'), {
                    type: 'bar', data: { labels: dataLabels, datasets: [{ label: 'Riesgos Residuales', data: [countsRr.Bajo, countsRr.Medio, countsRr.Alto, countsRr.Critico], backgroundColor: bgColors, borderColor: bColors, borderWidth: 1 }] },
                    options: { scales: { y: { beginAtZero: true, suggestedMax: Math.max(...Object.values(countsRr)) * 1.1 } }, plugins: { legend: { display: false } }, animation: { duration: 800 } }
                });
            } else {
                chartResidualInstance.data.datasets[0].data = [countsRr.Bajo, countsRr.Medio, countsRr.Alto, countsRr.Critico];
                chartResidualInstance.options.scales.y.suggestedMax = Math.max(...Object.values(countsRr)) * 1.1;
                chartResidualInstance.update();
            }
        }

        window.onload = initApp;
    </script>
</body>
</html>
